{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nyra-rose",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "ai": {
    "binding": "AI"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "nyra-rose-db",
      "database_id": "90bf2d54-132d-494b-bac4-ad0f58a3d320"
    }
  ],
  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "nyra-rose-store"
    }
  ],
  "observability": {
    "enabled": true
  }
}
